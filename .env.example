# =====================================================================
#  JobPortalApp - environment variables (TEMPLATE)
#  Copy this file to ".env" in the same folder and fill in real values.
#
#  .NET reads this file at startup (DotNetEnv). A double underscore "__"
#  maps to a nested config key:
#      ConnectionStrings__SqlServer  ->  ConnectionStrings:SqlServer
#  docker compose reads the same file automatically for ${...} values.
# =====================================================================

# ---------- Docker containers (docker-compose.yml) ----------
# Note: SQL Server / RabbitMQ only apply these on the FIRST start of a
# volume. To change them later, remove the volumes (docker compose down -v).
# SQL Server requires a strong password (8+ chars, upper, lower, digit).
MSSQL_SA_PASSWORD="ChangeMe123"
RABBITMQ_DEFAULT_USER="jobportal"
RABBITMQ_DEFAULT_PASS="change-me"

# ---------- API connection strings ----------
# User / password here must match the container values above.
ConnectionStrings__SqlServer="Server=localhost,1433;Database=JobPortalDbo;User Id=sa;Password=ChangeMe123;TrustServerCertificate=True;"
ConnectionStrings__Redis="localhost:6379"
ConnectionStrings__RabbitMQ="amqp://jobportal:change-me@localhost:5672"

# ---------- JWT ----------
# Signing key for access tokens (at least 32 characters, random).
# Generate one e.g. with PowerShell:
#   [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
TokenOption__SecurityKey="replace-with-a-long-random-secret-at-least-32-chars"

# ---------- Cloudinary (https://console.cloudinary.com -> API Keys) ----------
CloudinarySettings__CloudName="your-cloud-name"
CloudinarySettings__ApiKey="your-api-key"
CloudinarySettings__ApiSecret="your-api-secret"

# ---------- Admin account (created on startup if missing) ----------
# Password needs upper case, lower case and a digit (min. 6 chars).
AdminUser__Email="admin@jobportal.local"
AdminUser__UserName="admin"
AdminUser__Password="ChangeMe123"
